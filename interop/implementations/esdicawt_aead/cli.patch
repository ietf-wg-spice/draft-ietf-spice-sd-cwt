+
+// Typed contexts are decoded without rewriting the credential or presentation.
+fn read_aead_context(text: Option<&str>, path: Option<&std::path::Path>) -> eyre::Result<Option<esdicawt::spec::aead::AeadKeyContext>> {
+    eyre::ensure!(text.is_none() || path.is_none(), "choose one context representation");
+    if let Some(path) = path {
+        let bytes = std::fs::read(path)?;
+        return Ok(Some(ciborium::de::from_reader(bytes.as_slice())?));
+    }
+    Ok(text.map(|s| s.parse::<u64>().map(esdicawt::spec::aead::AeadKeyContext::Uint)
+        .unwrap_or_else(|_| esdicawt::spec::aead::AeadKeyContext::Text(s.to_owned()))))
+}
