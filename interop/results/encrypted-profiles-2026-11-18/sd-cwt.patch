+def test_bound_nested_disclosure_recursion():
+    ds = []
+    value = "leaf"
+    for _ in range(17):
+        d = disclosure(value, "child")
+        ds.append(d)
+        value = {R: [hash_disclosure(d)]}
+    with pytest.raises(ValueError, match="maximum depth"):
+        reconstruct_claims(value, ds)
